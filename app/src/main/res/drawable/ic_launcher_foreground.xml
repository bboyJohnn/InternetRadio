        android:pathData="M81,49 h-3 a5,5 0 0,0 -5,5 v14 a5,5 0 0,0 5,5 h3 a6,6 0 0,0 6,-6 v-12 a6,6 0 0,0 -6,-6 z" />
    <path android:fillColor="#FF3C6DA8"
        android:pathData="M28,53 h2 a3,3 0 0,1 3,3 v10 a3,3 0 0,1 -3,3 h-2 a3,3 0 0,1 -3,-3 v-10 a3,3 0 0,1 3,-3 z" />
    <path android:fillColor="#FF3C6DA8"
