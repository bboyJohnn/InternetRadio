        android:fillColor="#00000000"
        android:strokeColor="#FFC6D9F2"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:pathData="M27,53 C27,19 81,19 81,53" />

    <!-- globe (ocean) -->
    <path android:pathData="M54,80 a22,22 0 1,0 0,-44 a22,22 0 1,0 0,44 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34" android:startY="38"
                android:endX="74" android:endY="80">
                <item android:offset="0" android:color="#FF3E8FEA" />
                <item android:offset="1" android:color="#FF0D3A7E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- continents (clipped to the sphere) -->
    <group>
        <clip-path android:pathData="M54,80 a22,22 0 1,0 0,-44 a22,22 0 1,0 0,44 z" />
        <!-- Eurasia -->
        <path android:fillColor="#FF6FCF9E"
            android:pathData="M39,49 C40,45 45,44 49,44 C55,43 62,43 68,45 C71,46 71,49 68,51 C66,52 63,52 61,53 C60,55 58,54 57,55 C56,59 55,62 53,60 C52,56 50,54 48,54 C44,54 40,53 39,51 C38,50 38,50 39,49 z" />
