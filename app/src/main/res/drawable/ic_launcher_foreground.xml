            android:pathData="M48,56 C51,55 54,56 55,59 C55,62 54,65 52,68 C51,71 49,73 48,71 C46,68 45,63 45,60 C45,57 46,56 48,56 z" />
        <!-- Australia -->
        <path android:fillColor="#FF6FCF9E"
            android:pathData="M62,66 C65,65 68,66 69,68 C70,70 68,72 65,72 C62,72 60,69 61,67 C61,66 61,66 62,66 z" />
    </group>

    <!-- faint equator + meridian -->
    <path android:fillColor="#00000000" android:strokeColor="#40FFFFFF" android:strokeWidth="1.2"
        android:pathData="M54,36 a11,22 0 0,0 0,44 a11,22 0 0,0 0,-44" />
    <path android:fillColor="#00000000" android:strokeColor="#38FFFFFF" android:strokeWidth="1.2"
        android:pathData="M32,58 h44" />

    <!-- ear cups -->
    <path android:fillColor="#FF0E2647"
        android:pathData="M27,49 h3 a5,5 0 0,1 5,5 v14 a5,5 0 0,1 -5,5 h-3 a6,6 0 0,1 -6,-6 v-12 a6,6 0 0,1 6,-6 z" />
